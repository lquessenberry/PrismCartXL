{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Available variables:
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   - classes: List of classes
 * - view_mode: View mode, e.g. 'full', 'teaser'...
 * - paragraph: Fully loaded paragraph, configured in paragraph type.
 * - type: Paragraph type ID.
 * - bundle: Paragraph type label.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}

<div{{ attributes.addClass('paragraph--product-grid') }}>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for item in content.field_product %}
      <div class="product-card bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
        <h3 class="text-xl font-semibold mb-2">{{ item['#product'].title }}</h3>
        <p class="text-gray-600 mb-2">SKU: {{ item['#product'].sku }}</p>
        <div class="price text-lg font-bold">
          {{ item['#product'].variations[0].price.number|number_format(2) }}
          {{ item['#product'].variations[0].price.currency_code }}
        </div>
        <div class="mt-4">
          <a href="{{ item['#product'].url }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
            View Details
          </a>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
