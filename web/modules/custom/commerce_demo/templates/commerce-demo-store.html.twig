<div class="commerce-demo-store">
  <h2>{{ 'Store'|t }}</h2>
  <div class="store-info">
    <h3>{{ store.name }}</h3>
    <div class="store-address">
      <p>{{ store.address.address_line1 }}</p>
      <p>{{ store.address.locality }}, {{ store.address.administrative_area }}</p>
      <p>{{ store.address.postal_code }}</p>
    </div>
  </div>
</div>
