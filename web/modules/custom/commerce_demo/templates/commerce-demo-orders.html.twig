<div class="commerce-demo-orders">
  <h2>{{ 'Orders'|t }}</h2>
  <table class="orders-table">
    <thead>
      <tr>
        <th>{{ 'Order Number'|t }}</th>
        <th>{{ 'Customer'|t }}</th>
        <th>{{ 'Total'|t }}</th>
        <th>{{ 'Status'|t }}</th>
      </tr>
    </thead>
    <tbody>
      {% for order in orders %}
        <tr>
          <td>{{ order.order_number }}</td>
          <td>{{ order.customer.first_name }} {{ order.customer.last_name }}</td>
          <td>{{ order.total.amount }} {{ order.total.currency_code }}</td>
          <td>{{ order.state }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
