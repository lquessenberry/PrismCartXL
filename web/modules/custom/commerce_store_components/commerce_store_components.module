<?php

/**
 * Implements hook_entity_view_alter().
 */
function commerce_store_components_entity_view_alter(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display) {
  if ($entity->getEntityTypeId() === 'paragraph' && $entity->bundle() === 'product_grid') {
    // Add our custom template suggestions
    $build['#theme'][] = 'paragraph__product_grid__default';
  }
}

/**
 * Implements hook_theme().
 */
function commerce_store_components_theme($existing, $type, $theme, $path) {
  $module_path = \Drupal::service('extension.path.resolver')->getPath('module', 'commerce_store_components');
  
  return [
    'paragraph__product_grid__default' => [
      'render element' => 'elements',
      'base hook' => 'paragraph',
      'template' => 'paragraph--product-grid--default',
      'path' => $module_path . '/templates',
    ],
    'node__store_page' => [
      'render element' => 'elements',
      'base hook' => 'node',
      'template' => 'node--store-page',
      'path' => $module_path . '/templates',
    ],
    'commerce_store_components_product_grid' => [
      'variables' => [
        'products' => [],
        'items_per_page' => 12,
        'columns' => 3,
      ],
      'template' => 'commerce-store-components-product-grid',
    ],
  ];
}

/**
 * Implements hook_entity_type_alter().
 */
function commerce_store_components_entity_type_alter(array &$entity_types) {
  if (isset($entity_types['paragraph'])) {
    $entity_types['paragraph']->set('paragraphs_view_builder_id', 'commerce_store_components');
  }
}
