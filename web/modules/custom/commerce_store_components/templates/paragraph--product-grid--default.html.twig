{%
/**
 * @file
 * Template for rendering a product grid paragraph.
 */
%}

<div class="product-grid">
  {% for item in content.field_product %}
    {% set product = item['#product'] %}
    {% set variation = item['#variation'] %}
    
    <div class="product-card bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
      {% if product.image %}
        <div class="aspect-w-1 aspect-h-1 w-full overflow-hidden rounded-lg mb-4">
          <img src="{{ file_url(product.image.entity.uri.value) }}" 
               alt="{{ product.image.alt }}"
               class="object-cover object-center w-full h-full">
        </div>
      {% endif %}

      <h3 class="text-xl font-semibold mb-2">{{ product.title }}</h3>
      
      {% if variation %}
        <div class="flex items-center space-x-2 mb-4">
          <span class="text-gray-600">SKU:</span>
          <span class="font-medium">{{ variation.sku }}</span>
        </div>

        <div class="flex items-center space-x-2 mb-4">
          <span class="text-gray-600">Price:</span>
          <span class="text-lg font-bold">{{ variation.price.number|number_format(2) }} {{ variation.price.currency_code }}</span>
        </div>
      {% endif %}

      <div class="mt-4">
        <a href="{{ product.url }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
          View Details
        </a>
      </div>
    </div>
  {% endfor %}
</div>

{% block styles %}
  <style>
    {% include directory ~ '/css/product-grid.css' %}
  </style>
{% endblock %}
