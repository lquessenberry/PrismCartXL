{#
/**
 * @file
 * Template for rendering a product in the product grid.
 */
#}

<div class="product-card bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
  <h3 class="text-xl font-semibold mb-2">{{ product.title }}</h3>
  <p class="text-gray-600 mb-2">SKU: {{ variation.sku }}</p>
  <div class="price text-lg font-bold">
    {{ variation.price.number|number_format(2) }}
    {{ variation.price.currency_code }}
  </div>
  <div class="mt-4">
    <a href="{{ product.url }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
      View Details
    </a>
  </div>
</div>
